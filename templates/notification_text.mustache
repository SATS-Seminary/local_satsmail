{{!
    @template local_satsmail/notification_text

    Plain text notification template.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * coursename string Name of the course of the message
    * sendername string Full name of the sender of the message
    * date string Formatted date and time of the message
    * subject string Subject of the message
    * content string Formatted content of the message
    * hasattachments bool The message has attachments
    * attachments array List of attachments with path, size, url and icon
    * canreply bool The recipient can reply to the notification by email
    * viewurl string URL of the message

    Example context (json):
    {
        "coursename": "Introduction to Theology",
        "sendername": "Jane Doe",
        "date": "12 March 2026, 10:15",
        "subject": "Assignment feedback",
        "content": "Your feedback is attached.",
        "hasattachments": true,
        "attachments": [
            {
                "path": "feedback.pdf",
                "size": "12.3KB",
                "url": "https://example.com/pluginfile.php/1/local_satsmail/message/1/feedback.pdf"
            }
        ],
        "canreply": true,
        "viewurl": "https://example.com/local/satsmail/view.php?t=inbox&m=1"
    }
}}
{{#str}} from, local_satsmail {{/str}}: {{{ sendername }}}
{{#str}} subject, local_satsmail {{/str}}:  {{{ subject }}}
{{#str}} course, local_satsmail {{/str}}: {{{ coursename }}}
{{#str}} date, local_satsmail {{/str}}: {{{ date }}}

{{{ content }}}
{{# hasattachments }}

{{# attachments }}
{{{ path }}} ({{{ size }}}): {{{ url }}}
{{/ attachments }}
{{/ hasattachments }}

{{# canreply }}
{{#str}} replybyemail, local_satsmail {{/str}}
{{/ canreply }}
---------
{{#str}} viewmessage, local_satsmail {{/str}}: {{{ viewurl }}}

