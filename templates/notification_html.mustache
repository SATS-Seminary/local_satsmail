{{!
    @template local_satsmail/notification_html

    HTML notification template.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * coursename string Name of the course of the message
    * courseurl string URL of the course of the message
    * sendername string Full name of the sender of the message
    * senderurl string URL of the profile of the sender
    * date string Formatted date and time of the message
    * subject string Subject of the message
    * content string Formatted content of the message
    * hasattachments bool The message has attachments
    * attachments array List of attachments with path, size, url and icon
    * canreply bool The recipient can reply to the notification by email
    * viewurl string URL of the message

    Example context (json):
    {
        "coursename": "Introduction to Theology",
        "courseurl": "https://example.com/course/view.php?id=2",
        "sendername": "Jane Doe",
        "senderurl": "https://example.com/user/view.php?id=3&course=2",
        "date": "12 March 2026, 10:15",
        "subject": "Assignment feedback",
        "content": "<p>Your feedback is attached.</p>",
        "hasattachments": true,
        "attachments": [
            {
                "path": "feedback.pdf",
                "size": "12.3KB",
                "url": "https://example.com/pluginfile.php/1/local_satsmail/message/1/feedback.pdf",
                "icon": "https://example.com/theme/image.php/boost/core/1/f/pdf"
            }
        ],
        "canreply": true,
        "viewurl": "https://example.com/local/satsmail/view.php?t=inbox&m=1"
    }
}}
<div style="font-family: sans-serif">
    <table style="width: 100%; line-height: 1.5; border: 0; border-collapse: collapse; padding: 0">
        <tr>
            <td style="vertical-align: top; padding-right: 1em">{{#str}} from, local_satsmail {{/str}}:</td>
            <td><a target="_blank" href="{{{ senderurl }}}">{{ sendername }}</a></td>
        </tr>
        <tr>
            <td style="vertical-align: top; padding-right: 1em">{{#str}} subject, local_satsmail {{/str}}:</td>
            <td>
                <a target="_blank" href="{{ viewurl }}">
                    {{ subject }}
                </a>
            </td>
        </tr>
        <tr>
            <td style="vertical-align: top; padding-right: 1em">{{#str}} course, local_satsmail {{/str}}:</td>
            <td><a target="_blank" href="{{{ courseurl }}}">{{ coursename }}</a></td>
        </tr>
        <tr>
            <td style="vertical-align: top; padding-right: 1em">{{#str}} date, local_satsmail {{/str}}:</td>
            <td>{{ date }}</td>
        </tr>
    </table>
    <hr style="height: 1px; border: 0; border-top: 1px solid #ccc">
    {{{ content }}}
    {{# hasattachments }}
    <hr style="height: 1px; border: 0; border-top: 1px solid #ccc">
    {{# attachments }}
        <div style="margin: 8px 0">
            <img aria-hidden="true" alt="" src="{{ icon }}" width="24" height="24" style="vertical-align: middle">
            <a target="_blank" href="{{ url }}">{{ path }}</a> ({{ size }})
        </div>
    {{/ attachments }}
    {{/ hasattachments }}
    {{# canreply }}
    <hr style="height: 1px; border: 0; border-top: 1px solid #ccc">
    <p style="color: #666; font-style: italic">{{#str}} replybyemail, local_satsmail {{/str}}</p>
    {{/ canreply }}
    <hr style="height: 1px; border: 0; border-top: 1px solid #ccc">
    <a target="_blank" href="{{ viewurl }}">{{#str}} viewmessage, local_satsmail {{/str}}</a>
</div>

